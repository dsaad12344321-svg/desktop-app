{
  "name": "long-beach-hotel-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Long Beach Hotel Assistant - Windows desktop app",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "desktop:dev": "electron .",
    "desktop:dist": "npm run build && electron-builder --win nsis --publish never",
    "desktop:dist:dir": "npm run build && electron-builder --win dir --publish never"
  },
  "dependencies": {
    "@kenjiuno/msgreader-web-ng": "^0.3.0-alpha1",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.2.5",
    "mammoth": "^1.10.0",
    "next": "^15.5.6",
    "pdfjs-dist": "^5.4.394",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@kenjiuno/decompressrtf": "^0.1.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.longbeach.hotelassistant",
    "productName": "Long Beach Hotel Assistant",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "types/**/*",
      "public/**/*",
      ".next/**/*",
      "node_modules/**/*",
      "electron/**/*",
      "package.json",
      "next.config.ts",
      "tsconfig.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Long Beach Hotel Assistant"
    },
    "artifactName": "Long-Beach-Hotel-Assistant-Setup-${version}.${ext}"
  }
}
